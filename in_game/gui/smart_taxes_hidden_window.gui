basic_dialog = {
	name = "smart_taxes_hidden_window"
	widgetid = smart_taxes_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center

	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "Smart Taxes: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			visible = "[GetPlayer.Exists]"

			overlappingitembox = {
				state = {
					name = smart_taxes_init
					trigger_on_create = yes
					duration = 2
					on_finish = "[GetScriptedGui('smart_taxes_setup_defaults').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[PdxGuiWidget.TriggerAnimation('smart_taxes_init')]"
				}
			}

			text_single = {
				raw_text = "HI"
			}
			smart_taxes_auto_tax_disabler = {}
			smart_taxes_topbar = {}
		}
	}
}
