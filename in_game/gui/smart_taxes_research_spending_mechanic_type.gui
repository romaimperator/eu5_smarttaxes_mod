types SmartTaxes {
  #TGE
  type smart_taxes_research_spending_mechanic_type = adjustable_budget_card {
    layoutpolicy_horizontal = expanding
    size = { -1 55 }
    blockoverride "header_color" {
      using = color_economy_texture
    }

    # Smart Taxes adds check for existing of this variable to determine if the research spending mechanic mod is active
    visible = "[And(GetPlayer.MakeScope.Var('tge_research').IsSet, EconomyView.CanDoStabilityInvestment)]"

    blockoverride "top_widget" {
      hbox = {
        margin = { 5 0 }
        spacing = 5

        icon = {
          size = { 24 24 }
          texture = "gfx/interface/icons/flat_icons/advances_panel/research_speed.dds"
          texture_density = 2
        }

        text_single = {
          using = layoutpolicy_expanding
          autoresize = no
          align = left|nobaseline
          text = "EXPENSE_RESEARCH"
        }

        text_single = {
          autoresize = yes
          align = right|nobaseline
          text = "[FixedPointToFloat(Player.MakeScope.ScriptValue('tge_research_economic_share_sv_tooltip'))|2+=]@gold!"
        }

        tooltipwidget = {
          using = ResearchExpenseTooltip
          blockoverride "content_datacontext" {
            datacontext = "[Player.GetEconomy]"
          }
        }
      }
    }

    blockoverride "bottom_widget" {
      hbox = {
        margin = { 5 0 }
        spacing = 5

        widget = {
          using = layoutpolicy_expanding

          button_square_plus = {
            position = { 105 6 }
            size = { 15 15 }
            onclick = "[GetScriptedGui('tge_stability_inc').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
          }

          progressbar = {
            layoutpolicy_horizontal = expanding
            size = { 75 10 }
            position = { 22 9 }
            min = 0
            max = 1
            using = progress_bar_blue_alt
            value = "[FixedPointToFloat(Player.MakeScope.Var('tge_research').GetValue)]"
            direction = horizontal
            noprogresstexture = "gfx/interface/RE_blue.dds"
          }

          button_square_minus = {
            position = { 0 6 }
            size = { 15 15 }
            onclick = "[GetScriptedGui('tge_stability_dec').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
          }

        }

        text_single = {
          autoresize = no
          align = center|nobaseline
          size = { 60 20 }
          raw_text = "[FixedPointToFloat(Player.MakeScope.ScriptValue('tge_research_mod'))|2+=]@advance!"
          tooltipwidget = {
            ContextualTooltipType = {
              blockoverride "title_text" {
                text = "MODIFIER_TYPE_NAME_research_speed"
              }
              blockoverride "title_icon" {
                icon = {
                  using = tooltip_title_icon_size
                  texture = "gfx/interface/icons/flat_icons/advances_panel/research_speed.dds"
                }
              }


              blockoverride "concept_link" {
                text = [research_progress|E]
              }
              blockoverride "tooltip_content" {

                TooltipStringPairList = {
                  textcontext = "[Player.GetDoubleDescriptionFor('research_speed', 'research_speed_modifier')]"
                }
              }
            }
          }
        }
      }
    }
  }
}
