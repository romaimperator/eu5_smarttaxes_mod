types SmartTaxes {
	# Satisfaction equilibrium target for automation (default 50%). Normal: 1%, Ctrl: 5%, Alt: 10%, Shift: 0% or 100%.
	type smart_taxes_satisfaction_target_setter = widget {
		size = { 55 24 }
		visible = "[GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
		hbox = {
			datacontext = "[TaxRateSetting.GetEstate]"
			datacontext = "[TaxRateSetting.GetEstate.GetCountry]"
			using = bg_number_container_bckg
			blockoverride "number_container_extra" {
				alpha = 0.4
				margin = {2 4}
			}

			button_square_minus = {
				size = { 15 15 }
				enabled = yes
				tooltipwidget = { BasicFunctionalTooltip = {} }
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = default
					enabled = yes
					title = "SATISFACTION_TARGET_MINUS_1"
					on_action = "[GetScriptedGui('subtract_one_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = alt
					enabled = yes
					title = "SATISFACTION_TARGET_MINUS_10"
					on_action = "[GetScriptedGui('subtract_ten_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = shift
					enabled = yes
					title = "SATISFACTION_TARGET_SET_ZERO"
					on_action = "[GetScriptedGui('set_to_zero_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = ctrl
					enabled = yes
					title = "SATISFACTION_TARGET_MINUS_5"
					on_action = "[GetScriptedGui('subtract_five_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
			}

			text_single = {
				size = {25 20}
				autoresize = no
				using = Font_Size_Very_Small
				raw_text = "[GuiScope.AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).AddScope('country', TaxRateSetting.GetEstate.GetCountry.MakeScope).ScriptValue('current_target_satisfaction')|%0]"
				align = center
				tooltipwidget = {
					SimpleContextualTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/flat_icons/happy.dds"
							}
						}
						blockoverride "title_text" {
							text = "AUTOMATION_TARGET_SATISFACTION_TITLE"
						}
						lowpriotextcontext = "AUTOMATION_TARGET_SATISFACTION_TT"
					}
				}
			}

			button_square_plus = {
				size = { 15 15 }
				enabled = yes
				tooltipwidget = { BasicFunctionalTooltip = {} }
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = default
					enabled = yes
					title = "SATISFACTION_TARGET_PLUS_1"
					on_action = "[GetScriptedGui('add_one_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = alt
					enabled = yes
					title = "SATISFACTION_TARGET_PLUS_10"
					on_action = "[GetScriptedGui('add_ten_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = shift
					enabled = yes
					title = "SATISFACTION_TARGET_SET_HUNDRED"
					on_action = "[GetScriptedGui('set_to_one_hundred_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
				action_tooltip = {
					click_type = left
					click_mode = single
					click_modifier = ctrl
					enabled = yes
					title = "SATISFACTION_TARGET_PLUS_5"
					on_action = "[GetScriptedGui('add_five_percent').Execute(GuiScope.SetRoot(TaxRateSetting.GetEstate.GetCountry.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
				}
			}
		}
	}
}
