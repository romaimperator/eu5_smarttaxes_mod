types SmartTaxes {
	type smart_taxes_enabled_checkbox = button_checkbox {
		datacontext = "[TaxRateSetting.GetEstate]"
		datacontext = "[TaxRateSetting.GetEstate.GetType]"
		size = { 20 20 }
		checked = "[GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', EstateType.MakeScope).End)]"
		onclick = "[GetScriptedGui('smart_taxes_enabled').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', EstateType.MakeScope).End)]"
		tooltipwidget = { LeftClickButtonTooltip = { blockoverride "onclick_text" { text = "Toggle SmartTaxes for [Estate.GetName]" } } }
	}
}
