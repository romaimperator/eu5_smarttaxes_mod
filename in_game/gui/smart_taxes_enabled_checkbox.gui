types SmartTaxes {
	type smart_taxes_enabled_checkbox = button_checkbox {
		size = { 20 20 }
		autoresize = no
		checked = "[GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
		onclick = "[GetScriptedGui('smart_taxes_enabled').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End)]"
		tooltipwidget = { LeftClickButtonTooltip = { blockoverride "onclick_text" { text = "Toggle SmartTaxes for [TaxRateSetting.GetEstate.GetName]" } } }
	}
}