types SmartTaxes {
	type smart_taxes_replacement_enable_checkbox = button_checkbox_auto {
		datacontext = "[TaxRateSetting.GetEstate]"
		datacontext = "[TaxRateSetting.GetEstate.GetType]"
		size = { 22 22 }
		enabled = "[Not(IsPlayerAIEnabled('finances'))]"
		down = "[GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', EstateType.MakeScope).End)]"
		onclick = "[GetScriptedGui('smart_taxes_enabled').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', EstateType.MakeScope).End)]"

		tooltipwidget = {
			LeftClickButtonTooltip = {
				blockoverride "onclick_text" {
					text = "[SelectLocalization( GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', EstateType.MakeScope).End), 'DEACTIVATE_AUTO_TAX_RATE', 'ACTIVATE_AUTO_TAX_RATE' )]"
				}
			}
		}
	}
}
