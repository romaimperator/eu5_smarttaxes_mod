types SmartTaxes {
	# Auto-disables vanilla tax automation for estates where smart taxes is enabled.
	# Vanilla auto-tax is incompatible with smart taxes (both try to set the rate).
	type smart_taxes_auto_tax_disabler = widget {
		size = { 0 0 }
		datacontext = "[GetEconomyView]"
		datamodel = "[EconomyView.GetTaxRateSettings]"
		item = {
			widget = {
				size = { 0 0 }
				visible = "[And(TaxRateSetting.IsUsingAutoTaxRate, GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End))]"
				state = {
					name = _disable_auto_tax
					trigger_on_create = yes
					duration = 2
					on_finish = "[TaxRateSetting.ToggleAutoTaxRate]"
					next = _disable_auto_tax
				}
			}
		}
	}

	type smart_taxes_topbar = widget {
		state = {
			name = smart_taxes_hide
			trigger_on_create = yes
			next = smart_taxes_show
			on_finish = "[PdxGuiWidget.TriggerAnimation('smart_taxes_show')]"
		}
		state = {
			name = smart_taxes_show
			duration = 2
			on_finish = "[GetScriptedGui('smart_taxes_topbar_hide').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			next = smart_taxes_hide
		}
		visible = "[And(GetPlayer.Exists, GetScriptedGui('smart_taxes_show_topbar_to_recompute').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		datacontext = "[GetEconomyView]"
		datamodel = "[EconomyView.GetTaxRateSettings]"
		item = {
			smart_taxes_estate_tax_slider = {}
		}
	}
}
