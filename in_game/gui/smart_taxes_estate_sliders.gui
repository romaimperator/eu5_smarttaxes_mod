template smart_taxes_economy_lateralview {
	smart_taxes_estate_tax_slider = {}
}

types SmartTaxes {
	type smart_taxes_estate_tax_slider = widget {
		using = layoutpolicy_expanding
		economy_slider = {
			datacontext = "[TaxRateSetting.GetEstate.GetType]"
			datacontext = "[TaxRateSetting.GetEstate.GetCountry]"
			visible = "[GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(Country.MakeScope).AddScope('estate_type', EstateType.MakeScope).End)]"
			parentanchor = left|vcenter
			size = { 120 10 }
			#set value first or setting the min/max/mincap/maxcap changes the existing value from 0 to something inside the min/max/mincap/maxcap values
			value = "[TaxRateSetting.GetDefault]"
			min = 0
			max = 1
			mincap = "[GuiScope.AddScope('country', Country.MakeScope).AddScope('estate_type', EstateType.MakeScope).ScriptValue('smart_taxes_compute_tax_rate')]"
			maxcap = "[GuiScope.AddScope('country', Country.MakeScope).AddScope('estate_type', EstateType.MakeScope).ScriptValue('smart_taxes_compute_tax_rate')]"

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[GetEstateIcon(TaxRateSetting.GetEstate.GetType)]"
							texture_density = 2
							datacontext = "[TaxRateSetting.GetEstate]"
							datacontext = "[TaxRateSetting.GetEstate.GetCountry]"
							tooltipwidget = {
								using = Estate_tooltip
							}
						}
					}

					blockoverride "title_text" {
						datacontext = "[TaxRateSetting.GetEstate]"
						text = "ESTATE_TAX_MIN_MAX_T"
					}

					blockoverride "concept_link" {
						text = [tax|E]
					}

					blockoverride "tooltip_content" {
						datacontext = "[TaxRateSetting.GetEstate]"
						TooltipTextBlock = {
							blockoverride "text"	{
								text = "ESTATE_CURRENT_TAX_TT"
							}
						}

						TooltipStringPairList = {
							textcontext = "[TaxRateSetting.GetTaxSettingsTooltip]"
						}

						TooltipTextBlock = {
							visible = "[TaxRateSetting.IsUsingAutoTaxRate]"
							blockoverride "text"	{
								text = "ESTATE_CURRENT_TAX_AUTOMATED_TT"
							}
						}
					}
				}
			}

			onvaluechanged = "[TaxRateSetting.OnTaxChanged]"
			onchangefinish = "[TaxRateSetting.Post]"

			enabled = "[And(TaxRateSetting.IsTaxRateSliderEnabled, Or(TaxRateSetting.IsTaxRateSettingIncEnabled, TaxRateSetting.IsTaxRateSettingDecEnabled))]"
			alpha = "[TransparentIfFalse(Not(IsPlayerAIEnabled('finances')))]"
			blockoverride "economy_slider_inc_button_config"{
				enabled = "[TaxRateSetting.IsTaxRateSettingIncEnabled]"
			}
			blockoverride "economy_slider_dec_button_config"{
				enabled = "[TaxRateSetting.IsTaxRateSettingDecEnabled]"
			}
		}
		economy_slider = {
			visible = "[Not(GetScriptedGui('smart_taxes_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('estate_type', TaxRateSetting.GetEstate.GetType.MakeScope).End))]"
			parentanchor = left|vcenter
			size = { 120 10 }
			#set value first or setting the min/max/mincap/maxcap changes the existing value from 0 to something inside the min/max/mincap/maxcap values
			value = "[TaxRateSetting.GetDefault]"
			min = 0
			max = 1
			mincap = "[TaxRateSetting.GetMin]"
			maxcap = "[TaxRateSetting.GetMax]"

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[GetEstateIcon(TaxRateSetting.GetEstate.GetType)]"
							texture_density = 2
							datacontext = "[TaxRateSetting.GetEstate]"
							datacontext = "[TaxRateSetting.GetEstate.GetCountry]"
							tooltipwidget = {
								using = Estate_tooltip
							}
						}
					}

					blockoverride "title_text" {
						datacontext = "[TaxRateSetting.GetEstate]"
						text = "ESTATE_TAX_MIN_MAX_T"
					}

					blockoverride "concept_link" {
						text = [tax|E]
					}

					blockoverride "tooltip_content" {
						datacontext = "[TaxRateSetting.GetEstate]"
						TooltipTextBlock = {
							blockoverride "text"	{
								text = "ESTATE_CURRENT_TAX_TT"
							}
						}

						TooltipStringPairList = {
							textcontext = "[TaxRateSetting.GetTaxSettingsTooltip]"
						}

						TooltipTextBlock = {
							visible = "[TaxRateSetting.IsUsingAutoTaxRate]"
							blockoverride "text"	{
								text = "ESTATE_CURRENT_TAX_AUTOMATED_TT"
							}
						}
					}
				}
			}

			onvaluechanged = "[TaxRateSetting.OnTaxChanged]"
			onchangefinish = "[TaxRateSetting.Post]"

			enabled = "[And(TaxRateSetting.IsTaxRateSliderEnabled, Or(TaxRateSetting.IsTaxRateSettingIncEnabled, TaxRateSetting.IsTaxRateSettingDecEnabled))]"
			alpha = "[TransparentIfFalse(Not(IsPlayerAIEnabled('finances')))]"
			blockoverride "economy_slider_inc_button_config"{
				enabled = "[TaxRateSetting.IsTaxRateSettingIncEnabled]"
			}
			blockoverride "economy_slider_dec_button_config"{
				enabled = "[TaxRateSetting.IsTaxRateSettingDecEnabled]"
			}
		}
	}
}
